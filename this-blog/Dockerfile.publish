# The publisher: what turns a merge into the writing being on the site.
#
# Ghost keeps posts in MySQL and settings in MySQL, and neither is a file the
# Ghost image can carry the way it carries the theme. They go in over the admin
# API, and a GitHub runner has no route to Ghost. So the scripts that do it
# ship as an image, built from the same commit as the theme, and gitops runs
# it as an Argo PostSync Job inside the cluster once the new Ghost is Ready
# (apps/blog/base/publish-job.yaml). A merge publishes the writing the same
# way it publishes the theme; prod publishes on promotion.
#
# python:alpine rather than a layer on ghost:alpine: the two scripts want
# Python and Ghost wants none, and a Job that runs once per sync has no reason
# to weigh what Ghost weighs.
FROM python:3.12-alpine
RUN pip install --no-cache-dir markdown pyyaml
WORKDIR /app
# Same shape as the checkout, so ROOT in the scripts resolves the same way.
COPY scripts /app/scripts
COPY content /app/content
COPY theme/assets/img /app/theme/assets/img
USER 1000:1000
ENV HOME=/tmp
ENTRYPOINT ["sh", "-c", "python3 scripts/publish-content.py && python3 scripts/publish-settings.py"]
