{{!< default}}
{{#post}}
<article>
  {{#if feature_image}}
  {{!-- full-bleed, above the title, in normal flow: the reader scrolls past
        it once and it is gone. It carries the headline already, so the <h1>
        below is the accessible/indexable copy of the same words. --}}
  <figure class="cover">
    <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
  </figure>
  {{/if}}

  <div class="col head">
    <p class="kicker">
      {{#if primary_tag}}{{primary_tag.name}} · {{/if}}{{date published_at format="DD MMM YYYY"}} · {{reading_time}}
    </p>
    <h1 class="title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="sub">{{custom_excerpt}}</p>{{/if}}
  </div>

  <div class="prose">{{content}}</div>

  {{#if tags}}
  <div class="col posttags">{{#foreach tags}}<span>{{name}}</span>{{/foreach}}</div>
  {{/if}}
</article>
{{/post}}
