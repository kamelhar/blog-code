{{!< default}}
{{#tag}}
<section class="col section top">
  <div class="label"><span>{{name}}</span><i>{{plural ../pagination.total empty='no posts' singular='% post' plural='% posts'}}</i></div>
  <ol class="rows">
    {{#foreach ../posts}}
    <li>
      <a class="post" href="{{url}}">
        <span class="when">{{date published_at format="DD MMM"}}</span>
        <span><h2>{{title}}</h2>
        <p class="tags">{{#foreach tags}}{{name}}{{#unless @last}} · {{/unless}}{{/foreach}} · {{reading_time}}</p></span>
        {{#if feature_image}}<img class="thumb" src="{{img_url feature_image size="s"}}" alt="" loading="lazy">{{else}}<span></span>{{/if}}
      </a>
    </li>
    {{/foreach}}
  </ol>
  {{pagination}}
</section>
{{/tag}}
