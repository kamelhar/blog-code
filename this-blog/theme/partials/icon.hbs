{{!-- A glyph for a footer link, chosen by its label. Ghost has settings for exactly
      two social networks, so every other elsewhere -- github, a project, a paper --
      is a secondary_navigation entry, and this is how one gets a mark instead of
      only a word.

      Monochrome, 14px, currentColor: at this size a brand colour is a smudge, and
      inheriting the colour means the mark dims and brightens with the link it sits
      in rather than fighting it. A label with no glyph here renders as text alone,
      which is the correct default -- the word is the link, the mark is a courtesy. --}}
{{#match label "github"}}
<svg class="ico" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-2.91-.88-2.91-2.84 0-.56.2-1.02.53-1.38-.05-.13-.23-.66.05-1.37 0 0 .43-.14 1.41.53a4.8 4.8 0 0 1 2.6 0c.98-.67 1.41-.53 1.41-.53.28.71.1 1.24.05 1.37.33.36.53.82.53 1.38 0 1.97-1.14 2.64-2.92 2.84.3.26.56.76.56 1.54 0 1.11-.01 2-.01 2.27 0 .21.15.46.55.38A7.99 7.99 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
{{else match label "linkedin"}}
<svg class="ico" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M3.6 16H.3V5.3h3.3V16ZM1.9 3.9A1.9 1.9 0 1 1 1.9.1a1.9 1.9 0 0 1 0 3.8ZM16 16h-3.3v-5.6c0-1.34-.48-2.25-1.68-2.25-.92 0-1.46.62-1.7 1.21-.09.21-.11.51-.11.8V16H5.9s.04-9.7 0-10.7h3.3v1.51c.44-.68 1.22-1.65 2.98-1.65 2.18 0 3.82 1.42 3.82 4.48V16Z"/></svg>
{{else match label "x"}}
<svg class="ico" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
{{else match label "tulipagents.ai"}}
{{!-- the project's own mark, as published at tulipagents.ai/img/tulip-mark-pink.png.
      An <img> rather than a mask: it is a colour logo, and a logo recoloured to the
      page's ink is no longer the logo. Shipped at 4x for retina, 3KB. --}}
<img class="ico ico-img" src="{{asset "img/tulip-mark-pink.png"}}" alt="" width="14" height="14">
{{else match label "arxiv"}}
<svg class="ico" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M3 1h7l3.5 3.5V15H3V1Zm6.5.9V5H13L9.5 1.9ZM5 7.5h6v.8H5v-.8Zm0 2.3h6v.8H5v-.8Zm0 2.3h4v.8H5v-.8Z"/></svg>
