<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{meta_title}}</title>
<link rel="icon" href="{{asset 'img/icon.png'}}">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=JetBrains+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="{{asset 'css/measured.css'}}">
{{ghost_head}}
</head>
<body class="{{body_class}}">

<header class="col">
  <div class="bar">
    {{!-- Ghost's publication logo if one is set, the title if not. The theme was
          text-only, so uploading a logo in admin changed nothing and looked broken;
          this makes that setting mean what it says. --}}
    <a class="brand" href="{{@site.url}}">{{#if @site.logo}}<img class="brand-mark" src="{{img_url @site.logo size="xs"}}" alt="{{@site.title}}">{{else}}{{@site.title}}{{/if}}</a>
    <nav class="nav">
      {{!-- The two lists below are the theme's, not Ghost's. Ghost keeps navigation in
            settings, and its settings endpoint refuses API tokens -- only a signed-in
            staff session may write them -- so an admin-managed nav cannot be deployed,
            only typed. These two lists change about never, and "writing" is what this
            section is called; Ghost's default said "Home". To hand them back to the
            admin, restore {{#foreach @site.navigation}} with `this.url`. --}}
      <a href="{{@site.url}}/"{{#is "home"}} aria-current="page"{{/is}}>writing</a>
      <a href="{{@site.url}}/about/"{{#is "page"}} aria-current="page"{{/is}}>about</a>
    </nav>
  </div>
</header>

<main>{{{body}}}</main>

<footer class="foot">
  <div class="col foot-in">
    <span>new york</span>
    <span class="foot-links">
      <a href="https://github.com/fede-kamel">{{> icon label="github"}}github</a>
      <a href="https://www.linkedin.com/in/fedekamelhar/">{{> icon label="linkedin"}}linkedin</a>
      <a href="https://x.com/FedeKamelhar">{{> icon label="x"}}x</a>
      <a href="https://tulipagents.ai">{{> icon label="tulipagents.ai"}}tulipagents.ai</a>
      <a href="{{@site.url}}/rss/">rss</a>
    </span>
  </div>
</footer>

{{ghost_foot}}
</body>
</html>
