{{!< default}}
{{!-- One sentence, and only on the first page of the archive. This is not a hero:
      no cover, no call to action, no viewport-height anything -- it is the site
      saying what it is, once, in the serif, above the rule. It reads from the
      Ghost description setting, so changing it is a setting and not a deploy. --}}
{{#unless pagination.prev}}
  <section class="col slogan">
    {{!-- Ghost ships every new site with "Thoughts, stories and ideas." as its
          description, and an unset setting rendering at display size in the serif says
          less than nothing. The site's own sentence is the default here, and the
          Ghost description takes over the moment it is set to anything else --
          no deploy needed for that, which is the point of the {{#match}}. --}}
    {{#match @site.description "Thoughts, stories and ideas."}}
      <p>Building AI that works in production.</p>
    {{else}}
      <p>{{@site.description}}</p>
    {{/match}}
    {{!-- One sentence on who is writing, one on what is here and what it costs to
          read: what works, what breaks, what was learned.
          It must not repeat the slogan in the slogan's own voice: the standfirst
          before that was a .blurb, which lost every property it set to .slogan p and
          rendered at display size, so the top of the page said the same thing twice.
          Hence .standfirst, which outranks that rule rather than hoping to. --}}
    <p class="standfirst">
      I build AI agents and the platforms they run on. Here I write about agent
      architecture, orchestration, and infrastructure &mdash; what works, what breaks,
      and what I learn along the way.
    </p>
  </section>
{{/unless}}
<section class="col section top">
  <div class="label">
    <span>Writing</span>
    {{#get "posts" limit="1"}}{{#foreach posts}}<i>{{date published_at format="YYYY"}}</i>{{/foreach}}{{/get}}
  </div>
  <ol class="rows">
    {{#foreach posts}}
    <li>
      <a class="post" href="{{url}}">
        <span class="when">{{date published_at format="DD MMM"}}</span>
        <span>
          <h2>{{title}}</h2>
          {{!-- One sentence saying what is in it. A title and a reading time tell a
                reader how long something is, not whether it is for them; the excerpt
                is already written (it is the post's subtitle) and was going unused
                everywhere except the post's own page. --}}
          {{#if custom_excerpt}}<p class="says">{{custom_excerpt}}</p>{{/if}}
          <p class="tags">{{#foreach tags limit="1"}}{{name}} · {{/foreach}}{{reading_time}}</p>
        </span>
        {{#if feature_image}}
          <img class="thumb" src="{{img_url feature_image size="s"}}" alt="" loading="lazy" width="168" height="88">
        {{else}}<span></span>{{/if}}
      </a>
    </li>
    {{else}}
    <li><div class="post"><span class="when">—</span><span><h2>Nothing published yet.</h2></span><span></span></div></li>
    {{/foreach}}
  </ol>
  {{pagination}}
</section>

{{#unless pagination.prev}}
{{!-- The Work list, carried over from the bespoke site's content/work.yaml. It is
      four fixed lines about things that exist elsewhere, not posts, so it lives in
      the theme rather than in Ghost: editing it is a commit, which is the right
      weight for a list that changes once a year. Ordered by what is current: the
      thing being built first, the thing built at a previous employer last. Each
      name carries the same mark the About table gives that destination -- one
      CSS rule keyed on the href serves both. --}}
<section class="col section">
  <div class="label"><span>Work</span></div>
  <ol class="rows">
    <li>
      <div class="work">
        <span class="name"><a href="https://tulipagents.ai">Tulip Agents</a></span>
        <span class="what">open-source agentic framework · building</span>
        <span class="go"><a href="https://tulipagents.ai">tulipagents.ai</a></span>
      </div>
    </li>
    <li>
      <div class="work">
        <span class="name"><a href="https://arxiv.org/abs/2604.23366">GSAR</a></span>
        <span class="what">typed grounding for hallucination detection and recovery</span>
        <span class="go"><a href="https://arxiv.org/abs/2604.23366">arXiv</a></span>
      </div>
    </li>
    <li>
      <div class="work">
        <span class="name"><a href="https://github.com/fede-kamel">Open-source contributions</a></span>
        <span class="what">OCI support in LiteLLM, NeMo and vLLM production-stack</span>
        <span class="go"><a href="https://github.com/fede-kamel">github</a></span>
      </div>
    </li>
  <li>
      <div class="work">
        <span class="name"><a href="https://github.com/strands-agents/sdk-python">Strands Agents</a></span>
        <span class="what">led its creation at AWS · open source</span>
        <span class="go"><a href="https://github.com/strands-agents/sdk-python">github</a></span>
      </div>
    </li>
  </ol>
</section>
{{/unless}}
