{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local router (DGX Spark)",
      "options": {
        "baseURL": "http://ROUTER-HOST:4000/v1",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "qwen3.6-35b": { "name": "qwen3.6-35b", "limit": { "context": 131072, "output": 8192 } },
        "spark-only":  { "name": "spark-only",  "limit": { "context": 131072, "output": 8192 } }
      }
    }
  },
  "model": "local/qwen3.6-35b",
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "environment": { "SEARXNG_URL": "http://SEARXNG-HOST:8080" },
      "enabled": true
    }
  }
}
